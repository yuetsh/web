# 本地开发：复制为 server/.env 后修改
# Docker 部署：这些变量写在仓库根目录的 .env 里

# production 时使用线上域名作为跨域白名单
ENV=dev

# 以下均有默认值，一般不用改
# PORT=8000
# SQLite 数据库文件
# DB_PATH=data/db.sqlite3
# 上传文件目录
# MEDIA_ROOT=../media
# 允许访问 API 的前端地址，逗号分隔
# ALLOWED_ORIGINS=http://localhost:3000
# access token 的签名密钥；不配置则每次启动随机生成（重启后前端会自动刷新 token）
# JWT_SECRET=

LLM_API_KEY=
LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
